    "@bufbuild/protoc-gen-es": "^2.17.0",
    "@deck.gl/core": "9.4.1",
    "@deck.gl/layers": "9.4.1",
    "@deck.gl/mapbox": "9.4.1",
    "@eslint/js": "^9.39.5",
    "@types/node": "^22.20.5",
    "@types/pngjs": "6.0.5",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^16.4.0",
    "playwright": "1.65.1",
    "pngjs": "7.0.0",
    "prettier": "^3.10.1",
    "tsx": "4.23.15",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.73.0",
